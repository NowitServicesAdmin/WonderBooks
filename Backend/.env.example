MONGO_URI=
PORT=5000
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional 2nd Gemini key (use a key from a DIFFERENT Google project - quota is per project).
# Only used when GEMINI_API_KEY has hit its limit. Leave empty to use one key.
GEMINI_FALLBACK_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

JWT_SECRET=wonderbooks
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5


EMAIL_USER=noreply@nowitservices.com
EMAIL_PASS=
EMAIL_FROM=WonderBooks <no-reply@wonderbooks.app>

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_URL=

# Storage policy
R2_STORAGE_THRESHOLD_GB=9

# GEMINI_IMAGE_KEY / GEMINI_IMAGE_MODEL are no longer read by the code - safe to delete from .env

# Razorpay
RAZORPAY_KEY=rzp_test_C4JoiPhWbaM9w8
RAZORPAY_SECRET=JTS2whpU4GPKqsMkRBSk8hLq

# --- Optional tuning (all have defaults in code; set only to override) ---
# Gemini models. Each model has its own quota, so the 2nd one is a real fallback.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_PROMPT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenAI image generation / safety / chat
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_MODERATION=low
OPENAI_MODERATION_MODEL=omni-moderation-latest
CHAT_MODEL=gpt-4.1-mini

# Pages per generated book
BOOK_PAGE_COUNT=10

# SMS OTP (smslogin). If empty, OTPs are printed to the server console in dev.
SMSLOGIN_USERNAME=
SMSLOGIN_AUTH_KEY=
SMSLOGIN_SENDER_ID=
SMSLOGIN_TEMPLATE_ID=

# Check every generated picture matches its page (rejects random/unrelated images and regenerates).
# Set to off to disable. Uses a small vision call per image.
IMAGE_VERIFY=on
IMAGE_VERIFY_MODEL=gpt-4.1-mini